{
    "name": "apiverve/countryboundaries",
    "description": "Country Boundaries retrieves GeoJSON border outlines for any country by its two-letter ISO code. Each response includes the country name, geometry type, and boundary coordinate pairs ready for mapping layers.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "countryboundaries",
        "country boundaries api",
        "country geojson coordinates",
        "country border polygon",
        "get country borders",
        "country shape coordinates"
    ],
    "homepage": "https://apiverve.com/marketplace/countryboundaries?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/countryboundaries",
        "source": "https://github.com/apiverve/countryboundaries-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Countryboundaries\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Countryboundaries\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
